<?xml version="1.0" encoding="utf-8"?>
<!--
  ignatzcastror.lij.ligurian_keyboard.model.kps
  Author:   Ignatz-CastroR and contributors
  Date:     2026/10/17, 04:01:36, DESAMPARADOS CENTRO, SAN JOSE, COSTA RICA
  Purpose:  Keyman package of the Ligurian dictionary [lexical model].
  Contract: <Version> below is a placeholder. tools/build-keyman.ts
            replaces it, in a staging copy, with the dictionary
            snapshot's date as YYYY.M.D, so a newer dictionary always
            has a higher version. The committed file keeps 0.0.0.
-->
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.254</KeymanDeveloperVersion>
    <FileVersion>12.0</FileVersion>
  </System>
  <Options>
    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome.htm</WelcomeFile>
  </Options>
  <Info>
    <Name URL="">Dizionario ligure [grafîa ofiçiâ]</Name>
    <Copyright URL="">© 2026 Iosef Tesla R. [Ignatz-CastroR] and contributors</Copyright>
    <Author URL="">Ignatz-CastroR</Author>
    <Version URL="">0.0.0</Version>
    <WebSite URL="https://ignatz-castror.github.io/ligurian-keyboard/">ignatz-castror.github.io/ligurian-keyboard</WebSite>
    <Description>Suggerimenti in grafîa ofiçiâ per la tastiera ligure. Suggestions in grafîa ofiçiâ for the Ligurian keyboard.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\ignatzcastror.lij.ligurian_keyboard.model.js</Name>
    </File>
    <File>
      <Name>readme.htm</Name>
    </File>
    <File>
      <Name>welcome.htm</Name>
    </File>
    <File>
      <Name>..\LICENSE.md</Name>
    </File>
  </Files>
  <Keyboards/>
  <LexicalModels>
    <LexicalModel>
      <Name>Dizionario ligure [grafîa ofiçiâ]</Name>
      <ID>ignatzcastror.lij.ligurian_keyboard</ID>
      <Languages>
        <Language ID="lij">Ligure</Language>
      </Languages>
    </LexicalModel>
  </LexicalModels>
  <RelatedPackages/>
</Package>
