{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "engine/**/*.ts",
    "db/**/*.ts",
    "admin/**/*.ts",
    "editor/**/*.ts",
    "dictionary/**/*.ts",
    "tools/**/*.ts",
    "keyman/**/*.ts",
    "corpus/**/*.ts",
    "docs/**/*.ts"
  ],
  "exclude": [
    "admin/dist",
    "editor/dist",
    "dictionary/dist",
    "_site",
    "node_modules",
    "keyman/build",
    "keyman/dist"
  ]
}
