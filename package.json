{
  "name": "ligurian-keyboard",
  "version": "0.3.0",
  "description": "Scrivi in ligure [grafîa ofiçiâ] da qualsiasi tastiera | Write Ligurian in grafîa ofiçiâ from any keyboard",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"engine/test/**/*.test.ts\" \"db/test/**/*.test.ts\" \"admin/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "demo": "node engine/src/demo.ts",
    "check": "npm run typecheck && npm test",
    "test:engine": "node --test \"engine/test/**/*.test.ts\"",
    "test:db": "node --test \"db/test/**/*.test.ts\"",
    "test:admin": "node --test \"admin/test/**/*.test.ts\"",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:preview": "vite preview --config admin/vite.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  }
}
