# Copy this file to ".env" in the same folder and fill in your values.
# ".env" is ignored by git; this example file is committed on purpose.
#
# Both values are public by design: they are visible in the browser.
# Row level security in the database decides what each person may do.
# NEVER put the secret [service_role] key in this file or in any file
# whose variable name starts with VITE_.

# Supabase: Project Settings, Data API, Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase: Project Settings, API Keys, Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
