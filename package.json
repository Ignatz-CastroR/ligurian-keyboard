{
  "name": "ligurian-keyboard",
  "version": "0.7.0",
  "description": "Scrivi in ligure [grafîa ofiçiâ] da qualsiasi tastiera | Write Ligurian in grafîa ofiçiâ from any keyboard",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"engine/test/**/*.test.ts\" \"db/test/**/*.test.ts\" \"admin/test/**/*.test.ts\" \"editor/test/**/*.test.ts\" \"keyman/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "demo": "node engine/src/demo.ts",
    "check": "npm run typecheck && npm test",
    "test:engine": "node --test \"engine/test/**/*.test.ts\"",
    "test:db": "node --test \"db/test/**/*.test.ts\"",
    "test:admin": "node --test \"admin/test/**/*.test.ts\"",
    "test:editor": "node --test \"editor/test/**/*.test.ts\"",
    "test:keyman": "node --test \"keyman/test/**/*.test.ts\"",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:preview": "vite preview --config admin/vite.config.ts",
    "editor:dev": "vite --config editor/vite.config.ts",
    "editor:build": "vite build --config editor/vite.config.ts",
    "lexicon:snapshot": "node --env-file-if-exists=.env tools/fetch-lexicon.ts",
    "lexicon:fixture": "node tools/use-fixture-lexicon.ts",
    "keyman:layout": "node tools/write-touch-layout.ts",
    "keyman:build": "node tools/build-keyman.ts",
    "site:build": "npm run keyman:build && npm run editor:build && npm run admin:build && node tools/assemble-site.ts",
    "site:preview": "vite preview --config editor/vite.config.ts --outDir ../_site"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@keymanapp/kmc": "18.0.254",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  }
}
